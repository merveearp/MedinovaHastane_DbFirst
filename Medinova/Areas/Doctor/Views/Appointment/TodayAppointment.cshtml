@model List<Medinova.DTOs.AppointmentDtos.ResultAppointmentDto>

@{
    ViewBag.Title = "Bugünki Randevularım";
    Layout = "~/Areas/Doctor/Views/Shared/_DoctorLayout.cshtml";
    int count = 0;
}




<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h5 class="mb-0">
            <i class="fa-solid fa-clock text-warning me-2"></i>
            Günlük Randevu Planı
            <span class="text-muted fw-normal ms-1">
                (@ViewBag.AppointmentDate.ToString("dd.MM.yyyy"))
            </span>
        </h5>
    </div>


    <div class="card-body p-0">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Hasta</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>Durum</th>
                        <th>Tamamlanma</th>
                        <th class="text-end">Detay</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            count++;
                            <tr class="clickable-row"
                                data-href="@Url.Action("Detail","Appointment",
                                new { area="Doctor", appointmentId = item.AppointmentId })">

                                <td>@count</td>

                                <td>
                                    <strong>
                                        @item.PatientName @item.PatientLastName
                                    </strong>
                                </td>

                                <td>
                                    @item.AppointmentDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="far fa-clock me-1"></i>
                                        @item.AppointmentTime
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @item.BadgeClass">
                                        <i class="fa-solid @item.IconClass me-1"
                                           title="@item.IconTitle"></i>
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>
                                    @if (item.IsCompleted)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Tamamlandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-hourglass-half me-1"></i>
                                            Bekliyor
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a href="@Url.Action("Detail","Appointment",
                                        new { area="Doctor", appointmentId = item.AppointmentId })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-1"></i>
                                Gösterilecek randevu bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<!-- CLICKABLE ROW -->
<script>
    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            window.location = this.dataset.href;
        });
    });
</script>
