@model Medinova.DTOs.AppointmentDetailDtos.DetailAppointmentDto

@{
    ViewBag.Title = "Randevu Detayı Güncelle";
    Layout = "~/Areas/Doctor/Views/Shared/_DoctorLayout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
        ← Geri Dön
    </a>

    
</div>

@using (Html.BeginForm("Update", "AppointmentDetail", new { area = "Doctor" }, FormMethod.Post))
{
    @Html.HiddenFor(x => x.AppointmentId)
    @Html.HiddenFor(x => x.AppointmentDetailId)

    <!-- ÜST BİLGİ -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap">

            <div>
                <h4 class="mb-1 fw-bold">
                    Randevu Detayı Güncelle
                </h4>

                <div class="text-muted">
                    <i class="fas fa-user-md me-1"></i>
                    @Model.DoctorTitle @Model.DoctorName @Model.DoctorLastName
                    —
                    <span class="fw-semibold">@Model.AppointmentDepartment</span>
                </div>

                <div class="text-muted mt-1">
                    <i class="fas fa-user me-1"></i>
                    Hasta:
                    <strong>@Model.PatientName @Model.PatientLastName</strong>
                </div>
            </div>

            <div class="text-end mt-3 mt-md-0">
                <span class="badge @(Model.IsCompleted ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                    @(Model.IsCompleted ? "Tamamlanmış Randevu" : "Bekleyen Randevu")
                </span>

                <div class="text-muted small mt-2">
                    <i class="fas fa-calendar-alt me-1"></i>
                    @Model.AppointmentDate.ToString("dd MMMM yyyy")
                    &nbsp;|&nbsp;
                    <i class="fas fa-clock me-1"></i>
                    @Model.AppointmentTime
                </div>
            </div>

        </div>
    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            👤 Hasta Bilgileri
        </div>

        <div class="card-body">
            <div class="row align-items-center">

                <div class="col-md-3 text-center">
                    <img src="@Model.PatientImage"
                         class="rounded-circle mb-2"
                         style="width:90px;height:90px;object-fit:cover;border:2px solid #e5e7eb;" />

                    <div class="fw-bold">
                        @Model.PatientName @Model.PatientLastName
                    </div>
                    <small class="text-muted">@Model.PatientGender</small>
                </div>

                <div class="col-md-9">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>TC:</strong> @Model.PatientTC</p>
                            <p><strong>Telefon:</strong> @Model.PatientPhoneNumber</p>
                            <p><strong>Email:</strong> @Model.PatientEmail</p>
                        </div>

                        <div class="col-md-6">
                            <p><strong>Yaş:</strong> @Model.PatientAge</p>
                            <p><strong>Kan Grubu:</strong> @Model.BloodType</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            🩺 Tanı & Tedavi
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label fw-semibold">Tanı</label>
                @Html.TextAreaFor(x => x.Diagnosis,
                    new { @class = "form-control", rows = 3 })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Tedavi</label>
                @Html.TextAreaFor(x => x.Treatment,
                    new { @class = "form-control", rows = 3 })
            </div>


            <div class="card shadow-sm">
                <div class="card-header fw-bold">
                    📝 Doktor Notu
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Doktor Notu</label>
                        @Html.TextAreaFor(x => x.DoctorNote,
                            new { @class = "form-control", rows = 4 })
                    </div>

                </div>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-success">
                    💾 Güncelle
                </button>
            </div>

        </div>
    </div>

   
    
}
