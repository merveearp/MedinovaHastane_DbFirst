
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<style>
    .admin-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: #fff;
        border-top: 1px solid #e5e5e5;
        padding: 12px 0;
        z-index: 999;
    }
</style>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli | Medinova </title>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/css/bootstrap.css">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/vendors/iconly/bold.css">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/css/app.css">
    <link rel="shortcut icon" href="~/Templates/mazer/dist/assets/images/favicon.svg" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">





</head>

<body>
    <div id="app">
        <div id="sidebar" class="active">

            <div class="sidebar-wrapper active">
                <div class="sidebar-header text-center py-3">


                    <div class="mb-1">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                             style="width:36px;height:36px;background:#eef2ff;">
                            <i class="fa-solid fa-hospital text-primary"
                               style="font-size:16px;"></i>
                        </div>
                    </div>


                    <div class="fw-semibold text-primary"
                         style="font-size:14px;">
                        Medinova Hastane Resmi Doktor Paneli
                    </div>

                    <div class="my-2">
                        <img src="@(Session["DoctorImage"] != null
            ? Session["DoctorImage"].ToString()
            : Url.Content("~/Templates/medinova-1.0.0/img/doktor-avatar.png"))"
                             alt="Doktor"
                             class="rounded-circle"
                             style="width:42px;height:42px;object-fit:cover;" />
                    </div>


                    <div class="lh-1">
                        <div class="fw-semibold text-dark"
                             style="font-size:16px;">
                            @(Session["DoctorTitle"] ?? "") @(Session["DoctorFullName"] ?? "Doktor")
                        </div>

                        <small class="text-muted"
                               style="font-size:12px;">
                            @(Session["DoctorTitle"] ?? "")
                        </small>
                    </div>

                </div>


                <div class="sidebar-menu">
                    <ul class="menu">

                        <li class="sidebar-item active">
                            <a href="/Doctor/Home/Index" class="sidebar-link">
                                <i class="bi bi-speedometer2"></i>
                                <span>Anasayfa</span>
                            </a>
                        </li>

                        <li class="sidebar-title">Randevu Yönetimi</li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-calendar-check-fill"></i>
                                <span>Randevular</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a href="/Doctor/Appointment/Index">
                                        <i class="bi bi-list-check me-2"></i>
                                        Randevularım
                                    </a>
                                </li>
                                <li class="submenu-item">
                                    <a href="/Doctor/Appointment/TodayAppointment">
                                        <i class="bi bi-calendar-day me-2"></i>
                                        Bugünkü Randevular
                                    </a>
                                </li>
                            </ul>
                        </li>


                        <li class="sidebar-title">Hasta Yönetimi</li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-people-fill"></i>
                                <span>Hastalar</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a href="/Doctor/Patient/Index">
                                        <i class="bi bi-person-lines-fill me-2"></i>
                                        Hasta Listesi
                                    </a>
                                </li>
                            </ul>
                        </li>


                        <li class="sidebar-title">Hesap</li>

                        <li class="sidebar-item">
                            <a href="/Doctor/Profile/Index" class="sidebar-link">
                                <i class="bi bi-person-circle"></i>
                                <span>Profilim</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a href="/Doctor/Login/Logout" class="sidebar-link text-danger">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Çıkış Yap</span>
                            </a>
                        </li>

                    </ul>
                </div>


            </div>
        </div>

        <div id="main">
            <header class="mb-3">
                <a href="#" class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
            </header>

            @RenderBody()

            <footer class="admin-footer">
                <div class="clearfix text-muted px-3">
                    <div class="float-start">
                        <p class="mb-0">
                            © 2026 Medinova Sağlık Hizmetleri |  © @DateTime.Now.Year Medinova | Doktor Paneli
                        </p>
                    </div>
                    <div class="float-end">
                        <p class="mb-0">
                            Sağlıkta Güven ve Kalite
                        </p>
                    </div>
                </div>
            </footer>


        </div>
    </div>

    <script src="~/Templates/mazer/dist/assets/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="~/Templates/mazer/dist/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/Templates/mazer/dist/assets/vendors/apexcharts/apexcharts.js"></script>
    <script src="~/Templates/mazer/dist/assets/js/pages/dashboard.js"></script>
    <script src="~/Templates/mazer/dist/assets/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>

</html>