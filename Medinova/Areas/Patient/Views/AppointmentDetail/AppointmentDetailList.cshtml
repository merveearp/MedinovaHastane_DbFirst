@model List<Medinova.DTOs.AppointmentDetailDtos.ResultAppointmentDetailDto>

@{
    ViewBag.Title = "Muayene Sonuçları";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h4 class="mb-0">🩺 Hasta Muayene Sonuçları</h4>

    <a href="@Url.Action("Index", "Appointment", new { area = "Patient" })"
       class="btn btn-outline-secondary btn-sm">
        ← Randevulara Dön
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-bold">
        👤 @Session["PatientName"]
    </div>

    <div class="card-body">

        <table id="resultTable" class="table table-striped table-bordered align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Tarih</th>
                    <th>Bölüm</th>
                    <th>Tanı</th>
                    <th>Tedavi</th>
                    <th>Doktor Notu</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AppointmentDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="badge bg-primary">
                                    @item.AppointmentDepartment
                                </span>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.Diognasis)
                                  ? "-"
                                  : item.Diognasis)
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.Treatment)
                                  ? "-"
                                  : item.Treatment)
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.DoctorNote)
                                  ? "-"
                                  : item.DoctorNote)
                            </td>
                            <td>
                                <a href="@Url.Action(
                                        "Index",
                                        "AppointmentDetail",
                                        new {
                                            area = "Patient",
                                            appointmentId = item.AppointmentId,
                                            appointmentDetailId = item.AppointmentDetailId
                                        })"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>
</div>
<link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
    $(document).ready(function () {
        $('#resultTable').DataTable({
            pageLength: 5,
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
            }
        });
    });
</script>
