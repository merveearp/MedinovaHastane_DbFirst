@model Medinova.DTOs.AppointmentDetailDtos.DetailAppointmentDto

@{
    ViewBag.Title = "Randevu Detayı";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}

@if (Model == null)
{
    <div class="alert alert-warning text-center shadow-sm">
        🕒 Bu randevu için henüz muayene sonucu girilmemiştir.
    </div>

    <div class="text-center mt-3">
        <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
            ← Geri Dön
        </a>
    </div>

    return;
}

<div class="mb-4">
    <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
        ← Geri Dön
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-bold">
        👤 Hasta Bilgileri
    </div>
    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-3 text-center">
                <img src="@(string.IsNullOrEmpty(Model.PatientImage)
                            ? Url.Content("~/Templates/medinova-1.0.0/img/hasta-avatar.png")
                            : Model.PatientImage)"
                     class="rounded-circle mb-2"
                     style="width:90px;height:90px;object-fit:cover;border:2px solid #e5e7eb;" />

                <div class="fw-bold">
                    @Model.PatientName @Model.PatientLastName
                </div>
                <small class="text-muted">@Model.PatientGender</small>
            </div>

            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>TC:</strong> @Model.PatientTC</p>
                        <p><strong>Telefon:</strong> @Model.PatientPhoneNumber</p>
                        <p><strong>Email:</strong> @Model.PatientEmail</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Doğum Tarihi:</strong> @Model.PatientBirhtDate.ToString("dd.MM.yyyy")</p>
                        <p><strong>Yaş:</strong> @Model.PatientAge</p>
                        <p><strong>Kan Grubu:</strong> @(string.IsNullOrWhiteSpace(Model.BloodType) ? "Belirtilmemiş" : Model.BloodType)</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-bold">
        🩺 Randevu Detayı
    </div>

    <div class="card-body">

        <div class="mb-3">
            <label class="form-label fw-bold">Tanı</label>
            <textarea class="form-control" rows="4" readonly>
@(string.IsNullOrWhiteSpace(Model.Diagnosis) 
    ? "Henüz tanı girilmemiştir." 
    : Model.Diagnosis)
            </textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Tedavi</label>
            <textarea class="form-control" rows="4" readonly>
@(string.IsNullOrWhiteSpace(Model.Treatment) 
    ? "Henüz tedavi bilgisi girilmemiştir." 
    : Model.Treatment)
            </textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Doktor Notu</label>
            <textarea class="form-control" rows="4" readonly>
@(string.IsNullOrWhiteSpace(Model.DoctorNote) 
    ? "Doktor notu bulunmamaktadır." 
    : Model.DoctorNote)
            </textarea>
        </div>

    </div>
</div>
