@model Medinova.DTOs.ProfileDtos.PatientChangePasswordDto
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}



<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">

        <div class="d-flex align-items-center">
            <a href="@Url.Action("Index","Profile", new { area="Patient"})"
               class="btn btn-outline-secondary btn-sm me-3">
                <i class="fa fa-arrow-left"></i> Geri Dön
            </a>

            <h4 class="mb-0">🔐 Şifre Değiştir</h4>
        </div>

    </div>
</div>

@using (Html.BeginForm("ChangePassword", "Profile",
    new { area = "Patient" }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.UserId)

    <div class="card shadow-sm">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                <label class="form-label">Mevcut Şifre</label>
                @Html.PasswordFor(x => x.CurrentPassword,
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.CurrentPassword,
                    "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Şifre</label>
                @Html.PasswordFor(x => x.NewPassword,
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.NewPassword,
                    "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Yeni Şifre (Tekrar)</label>
                @Html.PasswordFor(x => x.ConfirmNewPassword,
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.ConfirmNewPassword,
                    "", new { @class = "text-danger" })
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-key"></i> Şifreyi Güncelle
                </button>
            </div>

        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    var errors = string.Join("\\n",
        ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => e.ErrorMessage.Replace("'", "\\'")));

    <script>
        Swal.fire({
            icon: 'error',
            title: 'Hata!',
            html: '@errors',
            confirmButtonColor: '#d33'
        });
    </script>
}





