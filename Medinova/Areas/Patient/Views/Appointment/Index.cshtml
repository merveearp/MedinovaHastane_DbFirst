@model List<Medinova.DTOs.AppointmentDtos.ResultAppointmentDto>
@{
    ViewBag.Title = "Randevularım";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
    int count = 0;
}





<div class="d-flex flex-wrap gap-2 mb-4">

    <a href="@Url.Action("Index","Appointment", new { area="Patient" })"
       class="btn btn-outline-primary">
        <i class="fas fa-calendar-alt me-1"></i>
        Tüm Randevular
    </a>

    <a href="@Url.Action("ActiveAppointment","Appointment", new { area="Patient" })"
       class="btn btn-outline-success">
        <i class="fas fa-clock me-1"></i>
        Yaklaşan
    </a>

    <a href="@Url.Action("PassiveAppointment","Appointment", new { area="Patient" })"
       class="btn btn-outline-danger">
        <i class="fas fa-times-circle me-1"></i>
        İptal Edilen
    </a>

    <a href="@Url.Action("IsCompletedAppointment","Appointment", new { area="Patient" })"
       class="btn btn-outline-secondary">
        <i class="fas fa-check-circle me-1"></i>
        Tamamlanan
    </a>
    <div>
        <a href="@Url.Action("CreateAppointment","Appointment", new { area="Patient" })"
           class="btn btn-success shadow-sm">
            <i class="fas fa-plus me-1"></i>
            Yeni Randevu
        </a>
    </div>

</div>

<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-calendar-check text-primary me-2"></i>
            Randevu Kayıtları
        </h5>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table id="appointmentTable" class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Departman</th>
                        <th>Doktor</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>Durum</th>
                        <th>Tamamlanma</th>
                        <th class="text-end">Detay</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            count++;
                            <tr class="clickable-row"
                                data-href="@Url.Action("AppointmentDetail","Appointment",
                                new { area="Patient", appointmentId = item.AppointmentId })">

                                <td>@count</td>

                                <td>
                                    <strong>
                                        @item.DoctorBranchName
                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        @item.DoctorTitle @item.DoctorName @item.DoctorLastName
                                    </strong>
                                </td>

                                <td>
                                    @item.AppointmentDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="far fa-clock me-1"></i>
                                        @item.AppointmentTime
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @item.BadgeClass">
                                        <i class="fa-solid @item.IconClass me-1"
                                           title="@item.IconTitle"></i>
                                        @item.StatusText
                                    </span>
                                </td>

                                <td>
                                    @if (!item.IsActive && item.IsCompleted)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Tamamlandı
                                        </span>
                                    }
                                    else if (item.IsActive && !item.IsCompleted)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-hourglass-half me-1"></i>
                                            Bekliyor
                                        </span>
                                    }
                                    else if(!item.IsActive && !item.IsCompleted)
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-times-circle me-1"></i>
                                            Tamamlanamadı
                                        </span>
                                    }
                                </td>


                                <td class="text-end">
                                    <a href="@Url.Action("AppointmentDetail","Appointment",
                                        new { area="Patient", appointmentId = item.AppointmentId })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-1"></i>
                                Gösterilecek randevu bulunamadı.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>


<script>
    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            window.location = this.dataset.href;
        });
    });
</script>

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: '@TempData["Success"]'
            });
        });
    </script>
}
<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {

        $('#appointmentTable').DataTable({
            pageLength: 25,
            order: [[4, "desc"]],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
            }
        });


        $(document).on("click", ".view-appointment", function () {

            var id = $(this).data("id");

            $("#appointmentModal").modal("show");

            $("#modalContent").html(
                '<div class="text-center p-4"><div class="spinner-border text-primary"></div></div>'
            );

            $.get('/Admin/Appointment/GetAppointmentModal',
                { id: id },
                function (data) {
                    $("#modalContent").html(data);
                });
        });

    });
</script>
