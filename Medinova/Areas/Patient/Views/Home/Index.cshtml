@model Medinova.DTOs.AIAppointmentViewDto

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
    int count = 0;
}

<style>

    .card:hover {
        transform: translateY(-4px);
        transition: all .2s ease;
    }

    .profile-card-hover {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .profile-card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
</style>

<div class="page-heading">
    <h3>📊 Hasta Paneli</h3>
</div>


<div class="page-content">
    <section class="row">
        <div class="col-12 col-lg-9">
            <div class="row">

                <div class="row">



                    <div class="col-6 col-lg-3 col-md-6 mb-4">
                        <a href="@Url.Action("Index","Appointment", new { area="Patient" })"
                           class="text-decoration-none">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <div class="stats-icon purple me-3">
                                        <i class="iconly-boldShow"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Toplam Randevu</div>
                                        <div class="fw-bold fs-4">@ViewBag.TotalAppointment</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-lg-3 col-md-6 mb-4">
                        <a href="@Url.Action("PassiveAppointment","Appointment", new { area="Patient" })"
                           class="text-decoration-none">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <div class="stats-icon blue me-3">
                                        <i class="iconly-boldProfile"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">İptal Randevu</div>
                                        <div class="fw-bold fs-4">@ViewBag.CanceledAppointmentCount</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-lg-3 col-md-6 mb-4">
                        <a href="@Url.Action("ActiveAppointment","Appointment", new { area="Patient" })"
                           class="text-decoration-none">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <div class="stats-icon green me-3">
                                        <i class="iconly-boldAdd-User"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Aktif Randevu</div>
                                        <div class="fw-bold fs-4">@ViewBag.ActiveAppointmentCount</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>


                    <div class="col-6 col-lg-3 col-md-6 mb-4">
                        <a href="@Url.Action("IsCompletedAppointment","Appointment", new { area="Patient" })"
                           class="text-decoration-none">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <div class="stats-icon red me-3">
                                        <i class="iconly-boldBookmark"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Tamamlanan</div>
                                        <div class="fw-bold fs-4">@ViewBag.CompletedAppointmentCount</div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                </div>

            </div>


            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4>@ViewBag.AppointmentDate Günün Programı</h4>
                        </div>
                        <div class="card-body">

                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Bölüm</th>
                                            <th>Doktor</th>
                                            <th>Tarih</th>
                                            <th>Saat</th>
                                            <th>Durum</th>
                                            <th>Tamamlanma</th>
                                            <th class="text-end">Detay</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (Model != null && Model.Appointments.Any())
                                        {
                                            foreach (var item in Model.Appointments)
                                            {
                                                count++;
                                                <tr class="clickable-row"
                                                    data-href="@Url.Action("AppointmentDetail","Appointment",
                                new { area="Patient", appointmentId = item.AppointmentId })">

                                                    <td>@count</td>
                                                    <td>
                                                        <strong>
                                                            @item.DoctorBranchName
                                                        </strong>
                                                    </td>


                                                    <td>
                                                        <strong>
                                                            @item.DoctorTitle  @item.DoctorName @item.DoctorLastName
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        @item.AppointmentDate.ToString("dd.MM.yyyy")
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-secondary">
                                                            <i class="far fa-clock me-1"></i>
                                                            @item.AppointmentTime
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <span class="badge @item.BadgeClass">
                                                            <i class="fa-solid @item.IconClass me-1"
                                                               title="@item.IconTitle"></i>
                                                            @item.StatusText
                                                        </span>
                                                    </td>

                                                    <td>
                                                        @if (!item.IsActive && item.IsCompleted)
                                                        {
                                                            <span class="badge bg-success">
                                                                <i class="fas fa-check-circle me-1"></i>
                                                                Tamamlandı
                                                            </span>
                                                        }
                                                        else if (item.IsActive && !item.IsCompleted)
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="fas fa-hourglass-half me-1"></i>
                                                                Bekliyor
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info">
                                                                <i class="fas fa-times-circle me-1"></i>
                                                                Tamamlanamadı
                                                            </span>
                                                        }
                                                    </td>


                                                    <td class="text-end">
                                                        <a href="@Url.Action("AppointmentDetail","Appointment",
                                        new { area="Patient", appointmentId = item.AppointmentId })"
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7"
                                                    class="text-center text-muted py-4">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Gösterilecek randevu bulunamadı.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-12">

                    <div id="aiResponse"></div>


                </div>


            </div>



        </div>





        <div class="col-12 col-lg-3">
            <a href="@Url.Action("Index", "Profile", new { area = "Patient" })"
               style="text-decoration:none;">

                <div class="card profile-card-hover">

                    <div class="card-body py-4 px-5">
                        <div class="d-flex align-items-center justify-content-between">

                            <div class="d-flex align-items-center">

                                <div class="avatar avatar-md">
                                    <img src="@(Session["PatientImage"] != null
                            ? Session["PatientImage"].ToString()
                            : Url.Content("~/Templates/medinova-1.0.0/img/hasta-avatar.png"))"
                                         alt="Doktor"
                                         class="rounded-circle shadow-sm"
                                         style="width:46px;height:46px;object-fit:cover;" />
                                </div>

                                <div class="ms-3 name lh-sm">
                                    <div class="fw-semibold text-dark">
                                        @(Session["PatientName"] ?? "Hasta")
                                    </div>

                                    <small class="text-muted d-block">
                                        @(Session["PatientTC"] ?? "")
                                    </small>

                                    <small class="text-muted">
                                        Kayıt Tarihi:
                                        @(ViewBag.CreatedUserDate != null
                                ? ((DateTime)ViewBag.CreatedUserDate).ToString("dd MMMM yyyy")
                                : "-")
                                    </small>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>

            </a>

            <div class="card shadow-sm">

                <div class="card-header bg-light-primary">
                    <h4 class="mb-0">
                        <i class="fas fa-stethoscope me-2 text-primary"></i>
                        Medinova Sağlık Asistanı
                    </h4>
                </div>

                <div class="card-content pb-4 px-4 pt-3">

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Şikayetinizi Yazın
                        </label>

                        <textarea id="aiQuestion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Örneğin: Boynum ağrıyor ne yapabilirim?"></textarea>
                    </div>

                    <button class="btn btn-primary w-100 mb-3"
                            onclick="askAI()">
                        <i class="fas fa-paper-plane me-1"></i>
                        Sor
                    </button>

                    <div id="aiResponse"></div>

                </div>
            </div>


            <div class="card shadow-sm">

                <div class="card-header">
                    <h4>🗓 Hızlı Randevu İşlemleri</h4>
                </div>

                <div class="card-content pb-4">

                    <div class="d-flex align-items-center px-4 py-3 border-bottom">
                        <div class="avatar avatar-lg bg-light-success">
                            <i class="fas fa-calendar-plus text-success fs-4"></i>
                        </div>
                        <div class="ms-4 flex-grow-1">
                            <h6 class="mb-1 fw-bold">Yeni Randevu Oluştur</h6>
                        </div>
                        <a href="@Url.Action("CreateAppointment","Appointment", new { area="Patient" })"
                           class="btn btn-sm btn-success">
                            +
                        </a>
                    </div>


                </div>
            </div>




        </div>
    </section>
</div>
@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var message = @Html.Raw(Json.Encode(TempData["Success"]));

            Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: message
            });

        });
    </script>
}


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>


<script>
    function askAI() {

        var question = $("#aiQuestion").val();

        if (!question || question.trim() === "") {
            alert("Lütfen şikayetinizi yazınız.");
            return;
        }

        $("#aiResponse").html(`
        <div class="text-muted text-center">
            <i class="fas fa-spinner fa-spin me-2"></i>
            Sağlık asistanı değerlendiriyor...
        </div>
    `);

        $.post("/Patient/Home/AskAI", { question: question }, function (data) {

            var html = `
                <div class="alert alert-info" style="white-space: pre-line;">
                    ${data.Answer}
                </div>
            `;

            if (data.Department) {
                html += `
                <div class="mt-2">
                    <strong>Önerilen Bölüm:</strong>
                    <span class="badge bg-primary ms-2">
                        ${data.Department}
                    </span>
                </div>
            `;
            }

            $("#aiResponse").html(html);
        })
            .fail(function () {
                $("#aiResponse").html(`
            <div class="alert alert-danger">
                AI servisine ulaşılamadı.
            </div>
        `);
            });
    }
</script>
