@model List<Medinova.DTOs.DoctorDtos.ResultDoctorDto>

@{
    ViewBag.Title = "Doktor Listesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="card">

    <div class="mb-3 d-flex gap-2">
        <a href="@Url.Action("Index","Doctor")"
           class="btn btn-outline-secondary btn-sm">
            Tüm Doktorlar
        </a>

        <a href="@Url.Action("ActiveDoctors","Doctor")"
           class="btn btn-outline-success btn-sm">
            Aktif Doktorlar
        </a>

        <a href="@Url.Action("PassiveDoctors","Doctor")"
           class="btn btn-outline-danger btn-sm">
            Pasif Doktorlar
        </a>
    </div>

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Doktor Listesi</h5>

        <a href="@Url.Action("DoctorRegister", "Doctor", new { area = "Admin" })"
           class="btn btn-primary btn-sm">
            + Yeni Doktor Ekle
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Doktor</th>
                        <th>Departman</th>
                        <th>Ünvan</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>

                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@item.ImageUrl"
                                         class="rounded-circle me-2"
                                         width="40"
                                         height="40" />

                                    <div>
                                        <strong>
                                            @item.FirstName @item.LastName
                                        </strong>
                                        <br />
                                        <small class="text-muted">
                                            @item.Email
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @item.DepartmentName
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>

                            <td class="text-end">

                                <a href="/Admin/Doctor/DoctorEdit/@item.DoctorId"
                                   class="btn btn-light-danger btn-sm">
                                    Düzenle
                                </a>

                                <a href="/Admin/Doctor/DoctorDetail/@item.DoctorId"
                                   class="btn btn-light-info btn-sm">
                                    Detay
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
