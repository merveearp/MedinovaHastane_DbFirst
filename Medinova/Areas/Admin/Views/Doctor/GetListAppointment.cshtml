@model List<Medinova.DTOs.AppointmentDtos.ResultAppointmentDto>

@{
    ViewBag.Title = "Randevu Kayıtları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<div class="row mb-4">
    <div class="col-12">
        <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
            ← Geri Dön
        </a>
    </div>
</div>

<div class="d-flex align-items-center mb-4 p-3 bg-white rounded shadow-sm">


    <img src="@ViewBag.DoctorProfile"
         alt="Doktor Fotoğrafı"
         class="rounded-circle me-3"
         style="width:60px;height:60px;object-fit:cover;border:2px solid #e5e7eb;" />


    <div>
        <h4 class="mb-1 fw-bold">
            🗓 @ViewBag.DoctorName
        </h4>
        <span class="text-muted">
            Doktora Ait Randevu Kayıtları
        </span>
    </div>

</div>

<div class="card shadow-sm">
    <div class="card-body p-0">

        <table id="appointmentTable" class="table table-striped">

            <thead class="thead-light">
                <tr>
                    <th>#</th>
                    <th>Hasta</th>
                    <th>Tarih</th>
                    <th>Saat</th>
                    <th>Durum</th>
                    <th>Branş</th>
                    <th>Tamamlanma</th>
                    <th class="text-end">Detay</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        count++;

                        <tr class="@(item.IsActive ? "appointment-active" : "appointment-passive") clickable-row"
                            data-href="@Url.Action(
                            "GetAppointmentByDoctorIdAsync",
                            "Doctor",
                            new { area = "Admin", doctorId = ViewBag.DoctorId, appointmentId = item.AppointmentId } )">

                            <td><strong>@count</strong></td>

                            <td>
                                <strong>@item.PatientName @item.PatientLastName</strong>
                            </td>

                            <td>@item.AppointmentDate.ToString("dd.MM.yyyy")</td>

                            <td>@item.AppointmentTime</td>

                            <td>
                                <span class="badge @item.BadgeClass">
                                    @item.StatusText
                                </span>
                            </td>

                            <td>@item.DoctorBranchName</td>

                            <td class="text-center">
                                @item.CompletedText
                                <i class="fas @item.IconClass" title="@item.IconTitle"></i>
                            </td>

                            <td class="text-end">
                                <a href="@Url.Action("GetAppointmentByDoctorIdAsync", "Doctor",
    new { area = "Admin", doctorId = ViewBag.DoctorId, appointmentId = item.AppointmentId })"
                                   class="btn btn-sm btn-outline-primary">
                                    Görüntüle
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            📭 Bu doktora ait henüz randevu kaydı bulunmamaktadır.
                        </td>
                    </tr>
                }
            </tbody>


        </table>

    </div>
</div>

<style>
    .appointment-active {
        background-color: #ecfdf5;
    }

    .appointment-passive {
        background-color: #fef2f2;
    }

    .badge-active {
        background: #16a34a;
        color: #fff;
        font-weight: 600;
    }

    .badge-passive {
        background: #dc2626;
        color: #fff;
        font-weight: 600;
    }

    .clickable-row {
        cursor: pointer;
    }

        .clickable-row:hover {
            background-color: #e0f2fe !important;
        }
</style>


<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            window.location = this.dataset.href;
        });
    });
</script>
<script>
    $(document).ready(function () {
        $('#appointmentTable').DataTable({
            pageLength: 25,
            order: [[0, "desc"]],
            language: {
                url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
            }
        });
    });
</script>
