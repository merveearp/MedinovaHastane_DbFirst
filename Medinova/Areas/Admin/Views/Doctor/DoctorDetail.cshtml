@model Medinova.DTOs.DoctorDtos.DoctorDetailDto

@{
    ViewBag.Title = "Doktor Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
            ← Geri Dön
        </a>
    </div>
</div>

<div class="row">

    <div class="col-xl-4 col-lg-5 col-md-12 mb-4">
        <div class="card shadow-sm h-100">

            <div class="card-body text-center">

                <img src="@Model.ImageUrl"
                     class="rounded-circle mb-3 shadow"
                     style="width:130px;height:130px;object-fit:cover;" />

                <h4 class="mb-1 text-primary">
                    <i class="fas fa-user-md me-1"></i> @Model.Title
                </h4>

                <h5 class="font-weight-bold mb-2">
                    @Model.FirstName @Model.LastName
                </h5>

                <span class="badge badge-pill badge-department mb-2 px-3 py-2">
                    <i class="fas fa-hospital me-1"></i> @Model.DepartmentName
                </span>

                <div class="mt-2">
                    <span class="badge badge-pill @(Model.IsActive ? "badge-active" : "badge-passive") px-3 py-2">
                        <i class="fas @(Model.IsActive ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                        @(Model.IsActive ? "Aktif" : "Pasif")
                    </span>
                </div>

                <hr />


                <a href="@Url.Action("GetListAppointment", "Doctor", new { area = "Admin", id = Model.DoctorId })"
                   class="btn btn-primary btn-sm w-100 mt-2">
                    <i class="fas fa-calendar-check me-1"></i>
                    Randevu Kayıtları
                </a>

            </div>

        </div>
    </div>

    <div class="col-xl-8 col-lg-7 col-md-12">
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">📋 Doktor Bilgileri</h5>
            </div>
            <div class="card-body">

                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>
                            <i class="fas fa-id-card text-secondary me-1"></i>
                            TC Kimlik No:
                        </strong><br />
                        <span class="text-dark">@Model.IdentityNumber</span>
                    </div>

                    <div class="col-md-6">
                        <strong>
                            <i class="fas fa-venus-mars text-secondary me-1"></i>
                            Cinsiyet:
                        </strong><br />
                        <span class="text-dark">@Model.GenderName</span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <strong>
                            <i class="fas fa-birthday-cake text-secondary me-1"></i>
                            Doğum Tarihi:
                        </strong><br />
                        <span>
                            @(Model.BirthDate.HasValue
                            ? Model.BirthDate.Value.ToString("dd.MM.yyyy")
                            : "Bilgisi girilmemiş")
                        </span>


                    </div>

                    <div class="col-md-4">
                        <strong>
                            <i class="fas fa-hourglass-half text-secondary me-1"></i>
                            Yaş:
                        </strong><br />
                        <span>
                            @(Model.Age.HasValue
                            ? Model.Age.ToString()
                            : "-")
                        </span>

                    </div>

                    <div class="col-md-4">
                        <strong>
                            <i class="fas fa-tint text-danger me-1"></i>
                            Kan Grubu:
                        </strong><br />
                        <span>@Model.BloodType</span>
                    </div>
                </div>

                <hr />

                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>
                            <i class="fas fa-phone-alt text-success me-1"></i>
                            Telefon:
                        </strong><br />
                        <span>@Model.PhoneNumber</span>
                    </div>

                    <div class="col-md-6">
                        <strong>
                            <i class="fas fa-envelope text-info me-1"></i>
                            E-posta:
                        </strong><br />
                        <span>@Model.Email</span>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-12">
                        <strong>
                            <i class="fas fa-align-left text-secondary me-1"></i>
                            Açıklama:
                        </strong>
                        <p class="mt-2 text-muted mb-0">
                            @Model.Description
                        </p>
                    </div>
                </div>

            </div>

        </div>


        <div class="card shadow-sm">
            <div class="card-body">
                <strong>Kayıt Tarihi:</strong>
                @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
            </div>
        </div>

    </div>

</div>


 <style >
    .badge-department {
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
    }

    .badge-active {
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(22, 163, 74, 0.35);
    }

    .badge-passive {
        background: linear-gradient(135deg, #dc2626, #991b1b);
        color: #fff;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(220, 38, 38, 0.35);
    }
</style>

