@model Medinova.DTOs.AccountDtos.DoctorRegisterDto

@{
    ViewBag.Title = "Doktor Kaydı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0">Yeni Doktor Kaydı</h4>
    </div>

    <div class="card-body">
        @using (Html.BeginForm("DoctorRegister", "Doctor", new { area = "Admin" }, FormMethod.Post))
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">TC Kimlik No</label>
                @Html.TextBoxFor(x => x.IdentityNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.IdentityNumber, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Telefon</label>
                @Html.TextBoxFor(x => x.PhoneNumber, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.PhoneNumber, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Kan Grubu</label>
                @Html.TextBoxFor(
                    x => x.BloodType,
                    new
                    {
                        @class = "form-control",
                        placeholder = "Ekleyiniz (A+, 0-, AB+ vb.)"
                    })
            </div>


            <div class="col-md-6 mb-3">
                <label class="form-label">Ad</label>
                @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Soyad</label>
                @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Cinsiyet</label>
                @Html.DropDownListFor(
                    x => x.GenderId,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Kadın", Value = "1" },
                        new SelectListItem { Text = "Erkek", Value = "2" }
                    },
                    "Seçiniz",
                    new { @class = "form-control" }
                )
                @Html.ValidationMessageFor(x => x.GenderId, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Doğum Tarihi</label>
                @Html.TextBoxFor(
                    x => x.BirthDate,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        @class = "form-control",
                        type = "date"
                    })
                @Html.ValidationMessageFor(x => x.BirthDate, "", new { @class = "text-danger small" })
            </div>



            <div class="col-md-6 mb-3">
                <label class="form-label">Departman</label>
                @Html.DropDownListFor(
                    x => x.DepartmentId,
                    ViewBag.Departments as SelectList,
                    "Departman Seçiniz",
                    new { @class = "form-control" }
                )
                @Html.ValidationMessageFor(x => x.DepartmentId, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Ünvan</label>
                @Html.TextBoxFor(x => x.Title, new { @class = "form-control", placeholder = "Uzman Doktor" })
            </div>


        </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", "Doctor", new { area = "Admin" })"
                   class="btn btn-secondary">
                    İptal
                </a>

                <button type="submit" class="btn btn-primary">
                    Doktoru Kaydet
                </button>
            </div>
        }
    </div>
</div>
