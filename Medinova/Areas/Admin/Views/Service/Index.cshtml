@model List<Medinova.DTOs.ServicesDtos.ResultServiceDto>

@{
    ViewBag.Title = "Service Listesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="card">

       
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">Hizmet Listesi</h4>

            <a href="/Admin/Service/Create"
               class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Yeni Ekle
            </a>
        </div>

      
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="width:80px;">İkon</th>
                            <th>Hizmet Adı</th>
                            <th>Açıklama</th>
                            <th style="width:180px;" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>

                                 
                                    <td>
                                        <i class="fa @item.ServiceIcon text-primary fs-5"></i>
                                    </td>

                                  
                                    <td class="fw-semibold">
                                        @item.ServiceName
                                    </td>

                                  
                                    <td class="text-muted">
                                        @(item.Description.Length > 80
                                            ? item.Description.Substring(0, 80) + "..."
                                            : item.Description)
                                    </td>

                                  
                                    <td class="text-center">
                                        <a href="/Admin/Service/Update/@item.ServiceId"
                                           class="btn btn-sm btn-warning me-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a href="/Admin/Service/Delete/@item.ServiceId"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Bu hizmeti silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Kayıt bulunamadı.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</section>
