@model Medinova.DTOs.DepartmentDtos.UpdateDepartmentDto

@{
    ViewBag.Title = "Departman Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8 col-md-10 col-sm-12">
        <div class="card shadow-sm">

            <div class="card-header">
                <h4 class="mb-0">
                    ✏️ Departman Güncelle
                </h4>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("Update", "Department", FormMethod.Post, new { area = "Admin" }))
                {
                    @Html.HiddenFor(x => x.DepartmentId)

                    <div class="form-group">
                        <label>Departman Adı</label>
                        @Html.TextBoxFor(x => x.Name, new
                        {
                            @class = "form-control",
                            placeholder = "Departman adını giriniz"
                        })
                        @Html.ValidationMessageFor(x => x.Name, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a href="/Admin/Department/Index" class="btn btn-secondary mr-2">
                            Vazgeç
                        </a>

                        <button type="submit" class="btn btn-warning">
                            <i class="fa fa-save"></i> Güncelle
                        </button>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
