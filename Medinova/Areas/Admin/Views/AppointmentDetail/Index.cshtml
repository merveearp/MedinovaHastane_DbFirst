@model List<Medinova.DTOs.AppointmentDetailDtos.ResultAppointmentDetailDto>

@{
    ViewBag.Title = "Muayene Detayları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading mb-4">
    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-file-medical text-primary me-2"></i>
                Muayene Detayları
            </h3>
            <p class="text-muted mb-0">
                Sistemde kayıtlı tüm muayene sonuçları
            </p>
        </div>

        <div class="text-end">
            <span class="badge bg-light-primary text-primary px-3 py-2">
                <i class="fa-solid fa-list-check me-1"></i>
                Toplam: @ViewBag.DetailCount
            </span>
        </div>

    </div>
</div>


<div class="card shadow-sm">
    <div class="card-body">

        <div class="mb-3">
            <a href="@Url.Action("Index","Home", new { area="Admin"})"
               class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1"></i>
                Anasayfaya Dön
            </a>
        </div>

        <div class="table-responsive">
            <table id="detailTable" class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Bölüm</th>
                        <th>Tarih</th>
                        <th>Tanı</th>
                        <th>Tedavi</th>
                        <th>Doktor Notu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AppointmentDetailId</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @item.AppointmentDepartment
                                </span>
                            </td>
                            <td>
                                @item.AppointmentDate.ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td>@item.Diognasis</td>
                            <td>@item.Treatment</td>
                            <td>
                                <small class="text-muted">
                                    @item.DoctorNote
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>


    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#detailTable').DataTable({
                "pageLength": 10,
                "order": [[0, "desc"]],
                "language": {
                    "search": "Ara:",
                    "lengthMenu": "Sayfada _MENU_ kayıt göster",
                    "info": "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    }
                }
            });
        });
    </script>

