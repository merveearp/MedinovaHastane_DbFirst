@if (Session["JustLoggedInAdmin"] != null)
{
    <script>
        Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: 'Hoş geldiniz @Session["FullName"]',
            showConfirmButton: false,
            timer: 2000
        });
    </script>
}

@{ Session.Remove("JustLoggedInAdmin"); }
