    const ctx = document.getElementById("myChart2").getContext("2d");

    const gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, "rgba(0, 171, 169, 0.4)");
    gradient.addColorStop(1, "rgba(0, 171, 169, 0)");

     new Chart(ctx, {
         type: "bar",
         data: {
             labels: xValues,
