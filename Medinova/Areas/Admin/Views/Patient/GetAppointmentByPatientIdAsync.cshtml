@model Medinova.DTOs.AppointmentDtos.GetAppointmentInfoDto

@{
    ViewBag.Title = "Randevu Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
        ← Geri Dön
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body d-flex align-items-center">
        <img src="@Model.PatientImage"
             class="rounded-circle me-3"
             style="width:70px;height:70px;object-fit:cover;border:2px solid #e5e7eb;" />

        <div>
            <h5 class="mb-1 fw-bold">
                @Model.PatientName @Model.PatientLastName
            </h5>
            <span class="text-muted">Randevuya Ait Hasta Bilgisi</span>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-bold">
        🩺 Doktor Bilgileri
    </div>

    <div class="card-body">
        <div class="row g-3">

            <div class="col-md-3 text-center">
                <img src="@Model.DoctorImage"
                     class="rounded-circle mb-2"
                     style="width:90px;height:90px;object-fit:cover;border:2px solid #e5e7eb;" />
                <div class="fw-bold">
                    Dr. @Model.DoctorName @Model.DoctorLastName
                </div>
                <small class="text-muted">@Model.PatientBrans</small>
            </div>

            <div class="col-md-9">
                <div class="row">

                    <div class="col-md-6">
                        <p><strong>Branş:</strong> @Model.DoctorBrans</p>
                        <p><strong>Ünvan:</strong> @Model.DoctorTitle</p>
                    </div>

                    <div class="col-md-6">
                        <p><strong>Email:</strong> @Model.DoctorEmail</p>
                        <p><strong>Telefon:</strong> @Model.DoctorPhoneNumber</p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-header fw-bold">
        🗓️ Randevu Bilgileri
    </div>

    <div class="card-body">
        <div class="row">

            <div class="col-md-4">
                <p>
                    <strong>Tarih:</strong><br />
                    @Model.AppointmentDate.ToString("dd.MM.yyyy")
                </p>
            </div>

            <div class="col-md-4">
                <p>
                    <strong>Saat:</strong><br />
                    @Model.AppointmentTime
                </p>
            </div>

            <div class="col-md-4">
                <p>
                    <strong>Durum:</strong><br />
                    @if (Model.IsCompleted)
                    {
                        <span class="badge bg-success">Tamamlandı</span>

                        <br />

                        <a href="@Url.Action(
                            "GetAppointmentDetailByPatientAsync",
                            "Patient",
                            new {
                                area = "Admin",
                                appointmentId = ViewBag.appointmentId,
                                isCompleted = true
                            })"
                           class="btn btn-sm btn-outline-success mt-2">
                            Randevu Detayı
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Bekliyor</span>
                    }
                </p>
            </div>

        </div>
    </div>
</div>
