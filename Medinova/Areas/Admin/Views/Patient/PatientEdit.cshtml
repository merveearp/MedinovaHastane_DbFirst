@model Medinova.DTOs.PatientDtos.PatientEditDto

@{
    ViewBag.Title = "PatientEdit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Hasta Kayıt Yönetimi</h4>
        <p class="text-muted mb-0">
            Bu ekran üzerinden hastanın sistemde aktiflik durumu yönetilir.
        </p>
    </div>
</div>

@if (TempData["CancelledCount"] != null && (int)TempData["CancelledCount"] > 0)
{
    <div class="alert alert-info mb-4">
        <i class="fas fa-info-circle me-1"></i>
        <strong>@TempData["CancelledCount"]</strong>
        adet aktif randevu iptal edildi.
    </div>
}

<div class="card mb-4">
    <div class="card-body d-flex align-items-center">
        <img src="@Model.ImageUrl"
             class="rounded-circle me-3"
             style="width:64px;height:64px;object-fit:cover;" />

        <div>
            <h5 class="mb-0">@Model.FirstName @Model.LastName</h5>
            <small class="text-muted">Hasta Bilgisi (Salt Okunur)</small>
        </div>
    </div>
</div>

@if (Model.ActiveAppointmentCount > 0)
{
    <div class="alert alert-warning mb-4 d-flex align-items-start">
        <i class="fas fa-exclamation-triangle fa-lg me-3 mt-1"></i>
        <div>
            <strong>Dikkat!</strong><br />
            Bu hastaya ait
            <strong>@Model.ActiveAppointmentCount</strong>
            adet <u>aktif randevu</u> bulunmaktadır.
            <br />
            Hastayı <strong>pasif</strong> hale getirirseniz bu randevular
            otomatik olarak <strong>iptal edilecektir.</strong>
        </div>
    </div>
}

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.PatientId)
    @Html.HiddenFor(x => x.UserId)

    <div class="form-check form-switch mb-4">
        @Html.CheckBoxFor(
            x => x.IsActive,
            new { @class = "form-check-input", id = "IsActive" }
        )
        <label class="form-check-label" for="IsActive">
            Hasta sistemde aktif
        </label>
    </div>

    <button type="submit" class="btn btn-primary me-2">
        <i class="fas fa-save me-1"></i> Kaydet
    </button>

    <a href="@Url.Action("Index", "Patient", new { area = "Admin" })"
       class="btn btn-outline-warning">
        Değişiklikten Vazgeç
    </a>
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.querySelector("form").addEventListener("submit", function (e) {

        const activeCount = @Model.ActiveAppointmentCount;
        const isActive = document.querySelector("#IsActive").checked;

        if (activeCount > 0 && !isActive) {
            e.preventDefault();

            Swal.fire({
                title: "Emin misiniz?",
                html: `<strong>${activeCount}</strong> adet aktif randevu iptal edilecek.`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Evet, devam et",
                cancelButtonText: "Vazgeç",
                confirmButtonColor: "#d33"
            }).then((result) => {
                if (result.isConfirmed) {
                    e.target.submit();
                }
            });
        }
    });
</script>
