@model Medinova.DTOs.ContactDtos.ResultContactDto

@{
    ViewBag.Title = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">İletişim Bilgileri</h4>

            <a href="/Admin/Contact/UpdateContact"
               class="btn btn-sm btn-primary">
                Bilgileri Düzenle
            </a>
        </div>

       
        <div class="card-body">

            <div class="row">

                <div class="col-md-8 mb-4">
                    <label class="fw-bold d-block mb-1">
                        <i class="fa fa-map-marker-alt me-2 text-primary"></i>
                        Adres
                    </label>
                    <p class="mb-0">
                        @Model.Address
                    </p>
                </div>

                <div class="col-md-8 mb-4">
                    <label class="fw-bold d-block mb-1">
                        <i class="fa fa-phone-alt me-2 text-primary"></i>
                        Telefon
                    </label>
                    <p class="mb-0">
                        @Model.PhoneNumber
                    </p>
                </div>

                <div class="col-md-8 mb-4">
                    <label class="fw-bold d-block mb-1">
                        <i class="fa fa-envelope me-2 text-primary"></i>
                        E-Posta
                    </label>
                    <p class="mb-0">
                        @Model.Mail
                    </p>
                </div>

                <div class="col-md-8 mb-4">
                    <label class="fw-bold d-block mb-1">
                        <i class="fa fa-clock me-2 text-primary"></i>
                        Çalışma Saatleri
                    </label>
                    <p class="mb-0">
                        @Model.WorkingHours
                    </p>
                </div>

            </div>

        </div>
    </div>
</section>
