@model List<Medinova.DTOs.AboutItemDtos.ResultAboutItemDto>

@{
    ViewBag.Title = "About Items";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="card">

       
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">Hakkımda İçerik Listesi</h4>

            <a href="/Admin/AboutItem/Create"
               class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Yeni Ekle
            </a>
        </div>

       
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="width:80px;">İkon</th>
                            <th>Alt Başlık</th>
                            <th>Başlık</th>
                            <th style="width:180px;" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>

                                    <td>
                                        <i class=" fa @item.Icon text-primary fs-5"></i>
                                    </td>

                                    <td class="fw-semibold">
                                        @item.Title
                                    </td>

                                    <td class="text-muted">
                                        @item.Name
                                    </td>

                                    <td class="text-center">
                                        <a href="/Admin/AboutItem/Update/@item.AboutItemId"
                                           class="btn btn-sm btn-warning me-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a href="/Admin/AboutItem/Delete/@item.AboutItemId"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Kayıt bulunamadı.
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
    </div>
</section>
