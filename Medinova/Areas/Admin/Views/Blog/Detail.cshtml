@model Medinova.DTOs.BlogDtos.UpdateBlogDto

@{
    ViewBag.Title = "Blog Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>
            <i class="fas fa-newspaper text-primary me-2"></i>
            Blog Detayı
        </h3>

        <div>
         
            <a href="@Url.Action("Update","Blog", new { area="Admin", id = Model.BlogId })"
               class="btn btn-warning btn-sm me-2">
                <i class="fas fa-edit me-1"></i>
                Güncelle
            </a>

           
            <a href="@Url.Action("Index","Blog", new { area="Admin"})"
               class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-arrow-left me-1"></i>
                Listeye Dön
            </a>
        </div>
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-body">


        <div class="mb-4 text-center">
            <img src="@Model.Image1"
                 class="img-fluid rounded shadow-sm"
                 style="max-height:400px; object-fit:cover;"
                 alt="Blog Image" />
        </div>


        <h2 class="fw-bold mb-2 text-center">
            @Model.BlogTitle
        </h2>


        <h5 class="text-muted text-center mb-4">
            @Model.BlogSubtitle
        </h5>


        <div class="d-flex justify-content-center align-items-center mb-4">
            <img src="@Model.WriterProfile"
                 class="rounded-circle me-2"
                 style="width:45px;height:45px;object-fit:cover;" />

            <span class="text-secondary">
                <i class="fas fa-user me-1"></i>
                @Model.BlogWriter
            </span>
        </div>

        <hr />


        <div class="blog-content mt-4">
            @Html.Raw(Model.BlogContent)
        </div>


        @if (!string.IsNullOrEmpty(Model.Image2))
        {
            <div class="mt-5 text-center">
                <img src="@Model.Image2"
                     class="img-fluid rounded shadow-sm"
                     style="max-height:350px; object-fit:cover;"
                     alt="Blog Image 2" />
            </div>
        }

    </div>
</div>

<style>
    .blog-content {
        font-size: 15px;
        line-height: 1.8;
        color: #444;
    }

        .blog-content p {
            margin-bottom: 1rem;
        }
</style>
