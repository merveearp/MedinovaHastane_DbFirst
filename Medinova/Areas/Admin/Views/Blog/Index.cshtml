@model List<Medinova.DTOs.BlogDtos.ResultBlogDto>

@{
    ViewBag.Title = "Blog Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>
            <i class="fas fa-blog text-primary me-2"></i>
            Blog Yönetimi
        </h3>

        <a href="@Url.Action("Create","Blog", new { area="Admin"})"
           class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>
            Yeni Blog Ekle
        </a>
    </div>
</div>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 blog-card">

                
                <a href="@Url.Action("Detail","Blog", new { area="Admin", id = item.BlogId })"
                   class="text-decoration-none text-dark">

                   
                    <img src="@item.Image1"
                         class="card-img-top"
                         style="height:220px; object-fit:cover;"
                         alt="Blog Image" />

                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            @item.BlogTitle
                        </h5>

                        <p class="text-muted small">
                            @item.BlogSubtitle
                        </p>

                        <div class="d-flex align-items-center mt-3">
                            <img src="@item.WriterProfile"
                                 class="rounded-circle me-2"
                                 style="width:35px;height:35px;object-fit:cover;" />

                            <span class="small text-secondary">
                                @item.BlogWriter
                            </span>
                        </div>
                    </div>
                </a>


                <div class="card-footer bg-white border-0 d-flex justify-content-between">

                    <a href="@Url.Action("Detail","Blog", new { area="Admin", id = item.BlogId })"
                       class="btn btn-sm btn-outline-info">
                        <i class="fas fa-eye"></i>
                    </a>

                    <a href="@Url.Action("Update","Blog", new { area="Admin", id = item.BlogId })"
                       class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-edit"></i>
                    </a>

                    <a href="@Url.Action("Delete","Blog", new { area="Admin", id = item.BlogId })"
                       class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-trash"></i>
                    </a>

                </div>

            </div>
        </div>
    }

</div>

<style>
    .blog-card {
        transition: 0.3s ease;
        cursor: pointer;
    }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }
</style>
