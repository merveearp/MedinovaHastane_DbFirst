@model List<Medinova.DTOs.TestimonialDtos.ResultTestimonialDto>

@{
    ViewBag.Title = "Referanslar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading mb-4">
    <h3>💬 Hasta Yorumları</h3>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">
            📋 Referans Listesi
        </span>

        <a href="@Url.Action("Create","Testimonial", new { area="Admin"})"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Yeni Referans Ekle
        </a>
    </div>

    <div class="card-body table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:80px;">#</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Yorum</th>
                    <th style="width:160px;" class="text-center">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TestimonialId</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>
                                @(item.Comment.Length > 60
                                    ? item.Comment.Substring(0, 60) + "..."
                                    : item.Comment)
                            </td>

                            <td class="text-center">
                                <a href="@Url.Action("Update","Testimonial",
                                         new { area="Admin", id=item.TestimonialId })"
                                   class="btn btn-outline-warning btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a href="@Url.Action("Delete","Testimonial",
                                         new { area="Admin", id=item.TestimonialId })"
                                   class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Henüz referans eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
