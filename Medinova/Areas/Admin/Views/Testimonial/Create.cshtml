@model Medinova.DTOs.TestimonialDtos.CreateTestimonialDto

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Yeni Referans Ekle</h2>

@using (Html.BeginForm("Create", "Testimonial", FormMethod.Post))
{
    <div class="form-group">
        <label>Ad</label>
        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Soyad</label>
        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Yorum</label>
        @Html.TextAreaFor(x => x.Comment, new { @class = "form-control", rows = 4 })
        @Html.ValidationMessageFor(x => x.Comment, "", new { @class = "text-danger" })
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a href="@Url.Action("Index","Testimonial")" class="btn btn-secondary">Listeye Dön</a>
}
