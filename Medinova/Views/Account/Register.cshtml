@model Medinova.DTOs.RegisterDto
@{
    Layout = null;
}



<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <title>Medinova | Hasta Kayıt</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/css/bootstrap.css">
    <link rel="stylesheet" href="~/Templates/mazer/dist/assets/vendors/bootstrap-icons/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #e6f7fb, #ffffff);
            min-height: 100vh;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            max-width: 500px;
            width: 100%;
            background: #fff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        .hospital-logo {
            width: 160px;
            margin-bottom: 10px;
        }

        .login-title {
            font-weight: 700;
            color: #0d6efd;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .form-control {
            height: 48px;
            border-radius: 10px;
        }

        .btn-medical {
            background-color: #0d6efd;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
        }
        .patient-avatar {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 50%;
            margin: 15px auto 10px;
            background: #f1f5f9;
            padding: 8px;
            display: block;
        }


            .btn-medical:hover {
                background-color: #0b5ed7;
            }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="login-card text-center">


            <img src="~/Templates/medinova-1.0.0/img/hasta-avatar.png"
                 class="patient-avatar" />


            <h3 class="login-title">Hasta Kayıt</h3>
            <p class="login-subtitle">
                Hasta profilinizi oluşturarak randevu ve sağlık hizmetlerine erişebilirsiniz
            </p>


            @using (Html.BeginForm("Register", "Account", new { area = "" }, FormMethod.Post))
            {
                <div class="row">
                    <div class="col-md-6 mb-3 text-start">
                        @Html.TextBoxFor(x => x.FirstName, new { @class = "form-control", placeholder = "Ad" })
                        @Html.ValidationMessageFor(x => x.FirstName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6 mb-3 text-start">
                        @Html.TextBoxFor(x => x.LastName, new { @class = "form-control", placeholder = "Soyad" })
                        @Html.ValidationMessageFor(x => x.LastName, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-3 text-start">
                    @Html.TextBoxFor(x => x.IdentityNumber, new { @class = "form-control", placeholder = "TC Kimlik No" })
                    @Html.ValidationMessageFor(x => x.IdentityNumber, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3 text-start">
                    @Html.TextBoxFor(x => x.PhoneNumber, new { @class = "form-control", placeholder = "Telefon" })
                    @Html.ValidationMessageFor(x => x.PhoneNumber, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3 text-start">
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "Email" })
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3 text-start">
                    @Html.DropDownListFor(x => x.GenderId,
                        new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Kadın", Value = "1" },
                            new SelectListItem { Text = "Erkek", Value = "2" }
                        },
                        "Cinsiyet Seçiniz",
                        new { @class = "form-control" })
                </div>

                <div class="mb-3 text-start">
                    @Html.TextBoxFor(x => x.BirthDate, new
                    {
                        @class = "form-control",
                        type = "date"
                    })
                    @Html.ValidationMessageFor(x => x.BirthDate, "", new { @class = "text-danger small" })
                </div>



                <div class="mb-3">
                    <div class="input-group">
                        @Html.PasswordFor(x => x.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Şifre",
                            id = "passwordInput"
                        })
                        <span class="input-group-text bg-white"
                              onclick="togglePassword('passwordInput','toggleIcon1')"
                              style="cursor:pointer;">
                            <i class="bi bi-eye" id="toggleIcon1"></i>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger small" })
                </div>


                <div class="mb-3">
                    <div class="input-group">
                        @Html.PasswordFor(x => x.ConfirmPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Şifre Tekrar",
                            id = "confirmPasswordInput"
                        })
                        <span class="input-group-text bg-white"
                              onclick="togglePassword('confirmPasswordInput','toggleIcon2')"
                              style="cursor:pointer;">
                            <i class="bi bi-eye" id="toggleIcon2"></i>
                        </span>
                    </div>
                    @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

            

                <button type="submit" class="btn btn-medical w-100">
                    Kayıt Ol
                </button>

                <a href="@Url.Action("Login", "Account", new { area = "" })"
                   class="btn btn-outline-secondary w-100 mt-3">
                    Zaten hesabım var
                </a>

            }

            <div class="mt-4 text-muted small">
                © @DateTime.Now.Year Medinova Sağlık Grubu
            </div>

        </div>
    </div>
    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }

    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>

</html>
