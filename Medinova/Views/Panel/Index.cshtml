@{
    ViewBag.Title = "Panel Seçimi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Medinova | Panel Seçimi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f1f6fb, #ffffff);
            min-height: 90vh;
            display: flex;
            align-items: center;
        }

        .panel-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            transition: all .3s ease;
            cursor: pointer;
        }

            .panel-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 18px 36px rgba(0,0,0,.12);
            }

            .panel-card img {
                height: 220px; 
                object-fit: contain;
                background-color: #f8f9fa;
                padding: 20px;
            }

            .panel-card .card-body {
                text-align: center;
                padding: 26px;
            }

        .panel-title {
            font-weight: 600;
            font-size: 1.25rem;
        }

        .panel-desc {
            color: #6c757d;
            font-size: .92rem;
            margin-top: 8px;
        }

        .logo {
            max-width: 180px;
            margin-bottom: 20px;
        }
        .btn-outline-info:hover {
            background-color: #f1f3f5;
        }

    </style>
</head>
<body>

    <div class="container">


        <div class="text-center mb-4">
            <img src="~/Templates/medinova-1.0.0/img/medinova-logo.png"
                 alt="Medinova Logo"
                 class="logo">
        </div>

        <div class="text-center mb-5">
            <h2 class="fw-bold">Yönetim Paneli</h2>
            <p class="text-muted">
                Lütfen giriş yapmak istediğiniz paneli seçiniz
            </p>
        </div>

        <div class="row justify-content-center g-4">


            <div class="col-md-5">
                <a href="/Account/Login" class="text-decoration-none text-dark">
                    <div class="card panel-card">
                        <img src="~/Templates/medinova-1.0.0/img/panel-admin.png" alt="Admin Panel">
                        <div class="card-body">
                            <div class="panel-title">Hastane Yönetimi</div>
                            <div class="panel-desc">
                                Sistem yönetimi, doktor ve hasta kontrolleri,
                                raporlar ve tüm operasyonel işlemler.
                            </div>
                        </div>
                    </div>
                </a>
            </div>


            <div class="col-md-5">
                <a href="/Account/Login" class="text-decoration-none text-dark">
                    <div class="card panel-card">
                        <img src="~/Templates/medinova-1.0.0/img/panel-doctor.png" alt="Doctor Panel">
                        <div class="card-body">
                            <div class="panel-title">Doktor Paneli</div>
                            <div class="panel-desc">
                                Randevu yönetimi, hasta bilgileri,
                                muayene ve sonuç işlemleri.
                            </div>
                        </div>
                    </div>
                </a>
            </div>

        </div>

        <div class="text-center mt-5">
            <a href="@Url.Action("Index","Default", new { area = "" })"
               class="btn btn-outline-info px-4 py-2">
                ← Anasayfaya Dön
            </a>
        </div>


    </div>

</body>
</html>
