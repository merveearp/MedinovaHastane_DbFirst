@model List<Medinova.Models.Service>



<section id="services">

    <div class="container-fluid py-5 bg-light">
        <div class="container">
            <div class="text-center mx-auto mb-5" style="max-width: 520px;">
                <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">
                    Hizmetlerimiz
                </h5>
                <h1 class="display-5 fw-bold">
                    Sağlığınız İçin <span class="text-primary">Profesyonel</span> Çözümler
                </h1>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="service-card h-100">
                            <div class="icon-box">
                                <i class="fa fa-2x @item.ServiceIcon"></i>
                            </div>

                            <h4 class="mt-4 mb-3">@item.ServiceName</h4>

                            <p class="text-muted">
                                @item.Description
                            </p>

                           
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


</section>





<style>
    .service-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 40px 30px;
        text-align: center;
        transition: all 0.35s ease;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
        position: relative;
        overflow: hidden;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
        }

    .icon-box {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #13c5dd, #1d2a4d);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        transition: all 0.35s ease;
    }

        .icon-box i {
            color: #fff;
        }

    .service-card:hover .icon-box {
        transform: rotate(10deg) scale(1.1);
    }

    .service-card h4 {
        font-weight: 600;
    }

    .service-bt

</style>