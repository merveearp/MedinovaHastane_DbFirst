@model List<Medinova.Models.Testimonial>

<div class="container-fluid py-5 bg-light">
    <div class="container">

        <!-- Section Title -->
        <div class="text-center mx-auto mb-5" style="max-width: 520px;">
            <h1 class="display-6 fw-bold">
                Hastalarımız Bizim İçin Ne Diyor?
            </h1>
            <p class="text-muted mt-2">
                Medinova’da hasta memnuniyeti her zaman önceliğimizdir.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="owl-carousel testimonial-carousel">

                    @foreach (var item in Model)
                    {
                        <div class="testimonial-item bg-white shadow-sm rounded-4 p-5 text-center mx-2">

                            <!-- Quote Icon -->
                            <div class="mb-3">
                                <i class="fa fa-quote-left fa-2x text-primary opacity-50"></i>
                            </div>

                            <!-- Comment -->
                            <p class="fs-5 fst-italic text-secondary mb-4">
                                “@item.Comment”
                            </p>

                            <hr class="w-25 mx-auto mb-3">

                            <!-- Name -->
                            <h5 class="fw-semibold mb-0 text-dark">
                                @item.FirstName @item.LastName
                            </h5>

                            <small class="text-muted">
                                Hasta
                            </small>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .testimonial-item {
        transition: all 0.3s ease;
    }

        .testimonial-item:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
        }
</style>
