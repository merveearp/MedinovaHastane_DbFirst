@model List<Medinova.Models.Media>

<h6 class="text-primary text-uppercase mt-4 mb-2 fw-semibold">
    Bizi Takip Edin
</h6>

<p class="text-muted mb-3 small">
    Güncel duyurularımız, sağlık bilgilendirmeleri ve yenilikler için
    sosyal medya hesaplarımızı takip edebilirsiniz.
</p>

<div class="d-flex align-items-center gap-2 social-links">

    @foreach (var item in Model)
    {
        <a href="@item.MediaUrl"
           target="_blank"
           class="social-btn"
           title="@item.MediaName"
           aria-label="@item.MediaName">

            <i class="@item.MediaIcon"></i>
        </a>
    }

</div>

<style>
    .social-links .social-btn {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #f1f6fb;
        color: #0d6efd;
        font-size: 18px;
        transition: all 0.25s ease;
        text-decoration: none;
    }

        .social-links .social-btn:hover {
            background-color: #0d6efd;
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.25);
        }

</style>