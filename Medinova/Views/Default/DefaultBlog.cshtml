@model List<Medinova.Models.Blog>

<div class="container-fluid py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h5 class="d-inline-block text-primary text-uppercase border-bottom border-5">
                    📝 Blog Yazıları
                </h5>
                <h1 class="display-5 fw-bold">
                    Sağlık Hakkında Güncel Paylaşımlar
                </h1>
            </div>


        </div>
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">

                    <div class="card h-100 shadow-sm border-0 blog-card view-blog"
                         data-id="@item.BlogId"
                         style="cursor:pointer;">

                        <img src="@item.Image1"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;"
                             alt="Blog Image" />

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @item.BlogTitle
                            </h5>

                            <p class="card-text text-muted small mb-3">
                                @item.BlogSubtitle
                            </p>

                        </div>

                        <div class="card-footer bg-white border-top d-flex align-items-center">
                            <img src="@item.WriterProfile"
                                 class="rounded-circle me-2"
                                 width="35"
                                 height="35"
                                 style="object-fit:cover;"
                                 alt="Yazar" />
                            <small class="text-muted">@item.BlogWriter</small>
                        </div>

                    </div>

                </div>
            }
        </div>

    </div>



    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Blog Detayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" id="modalContent">
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    $(document).on("click", ".view-blog", function () {

        var id = $(this).attr("data-id");
        console.log(id);

        if (!id) return;

        var modal = new bootstrap.Modal(document.getElementById('appointmentModal'));
        modal.show();

        $("#modalContent").html(
            '<div class="text-center p-4"><div class="spinner-border text-primary"></div></div>'
        );

        $.get('@Url.Action("Detail","Default")',
            { id: id },
            function (data) {
                $("#modalContent").html(data);
            })
            .fail(function () {
                $("#modalContent").html("<p class='text-danger'>Blog yüklenemedi.</p>");
            });
    });
    </script>
