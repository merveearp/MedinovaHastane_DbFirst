

@{
    Layout = null;
}

@model Medinova.DTOs.BlogDtos.UpdateBlogDto



<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">

            <li class="breadcrumb-item">
                <a href="@Url.Action("Index","Default")">
                    <i class="bi bi-house-door-fill me-1"></i> Anasayfa
                </a>
            </li>

            <li class="breadcrumb-item">
                <a href="@Url.Action("Index","Blog",new {area =""})">
                    Blog
                </a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
                @Model.BlogTitle
            </li>

        </ol>
    </nav>



    <div class="mb-5">
        <img src="@Model.Image1"
             class="img-fluid rounded shadow-sm w-100"
             style="max-height:450px; object-fit:cover;"
             alt="Blog Görsel" />
    </div>


    <div class="text-center mb-4">
        <h1 class="fw-bold">@Model.BlogTitle</h1>
        <p class="text-muted fs-5">@Model.BlogSubtitle</p>
    </div>


    <div class="d-flex justify-content-center align-items-center mb-5">
        <img src="@Model.WriterProfile"
             class="rounded-circle me-3 shadow-sm"
             width="60"
             height="60"
             style="object-fit:cover;" />

        <div>
            <div class="fw-semibold">@Model.BlogWriter</div>
            <small class="text-muted">Yazar</small>
        </div>
    </div>


    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="blog-content fs-5 text-muted" style="line-height:1.8;">
                @Html.Raw(Model.BlogContent)
            </div>

        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Image2))
    {
        <div class="mt-5 text-center">
            <img src="@Model.Image2"
                 class="img-fluid rounded shadow-sm"
                 style="max-height:400px; object-fit:cover;"
                 alt="Blog Ek Görsel" />
        </div>
    }


</div>
